namespace org.gatun.protocol;

// Protocol version - increment when making breaking changes.
// It is checked during the handshake to ensure client/server compatibility.
// The current value lives in PROTOCOL_VERSION (GatunServer.java and client.py).

enum Action : byte {
  Ping = 0,
  ComputeSum = 1,
  CreateObject = 2,
  InvokeMethod = 3,
  FreeObject = 4,
  SendArrowBatch = 5,
  InvokeStaticMethod = 6,
  GetField = 7,
  SetField = 8,
  RegisterCallback = 9,    // Python registers a callback, gets callback_id
  UnregisterCallback = 10, // Python unregisters a callback
  CallbackResponse = 11,   // Python sends result of callback execution back to Java
  Cancel = 12,             // Interrupt another session's running request; sent on a second
                           // connection, with target_name = that session's shared memory path
  IsInstanceOf = 13,       // Check if object is instance of a class
  SendArrowBuffers = 14,   // Send Arrow data via buffer descriptors (true zero-copy)
  ResetPayloadArena = 15,  // Reset the payload shared memory arena
  GetArrowData = 16,       // Request Arrow data from Java (returns via ArrowBatchDescriptor)
  GetStaticField = 17,     // Get static field value: target_name = "pkg.Class.FIELD"
  SetStaticField = 18,     // Set static field value: target_name = "pkg.Class.FIELD", args[0] = value
  Reflect = 19,            // Reflection query: check if name is class, get member type
  Batch = 20,              // Execute multiple commands in a single round-trip
  // Vectorized operations - single round-trip for multiple operations on same target
  GetFields = 21,          // Get multiple fields from one object: target_id + field_names
  InvokeMethods = 22,      // Invoke multiple methods on same target: target_id + method_calls
  CreateObjects = 23,      // Create multiple objects: class_names + args per object
  GetMetrics = 24,         // Get server metrics (request counts, latencies, object counts, etc.)
  ArrowToObject = 25,      // Turn the IPC stream at arrow_stream into a Java object; see ArrowForm
  ArrowFromObject = 26,    // Write the VectorSchemaRoot target_id as an IPC stream; see Response.arrow_stream
  OpenCallbackChannel = 27, // Open the session's callback connection; returns the path of a socket
                           // that accepts exactly one connection (see "Callback connection" below)
  NestedCommand = 28,      // On the callback connection: a command sent from inside a callback; see Command.nested_command
  OpenCallMemory = 29      // Inside a NestedCommand: create the call's own shared memory; returns the file's path
}

// For Action.ArrowToObject: what the stream becomes in the JVM
enum ArrowForm : byte {
  Table = 0,      // A VectorSchemaRoot that owns a copy of the data
  LentTable = 1,  // A VectorSchemaRoot that reads the data where the client wrote it. The client
                  // leaves those bytes alone until it frees the object (or resets the payload
                  // arena), and the table cannot be read from then on. On the session's own
                  // channel only.
  Batches = 2     // A java.util.ArrayList<byte[]>: each record batch of the stream as the bytes
                  // of its IPC message
}

// Element types for arrays
enum ElementType : byte {
  Int = 0,
  Long = 1,
  Double = 2,
  Float = 3,
  Bool = 4,
  String = 5,
  Object = 6,  // For Object[] or typed arrays of objects
  Byte = 7,
  Short = 8,
  Char = 9
}

// Support all return types
union Value {
  StringVal,
  IntVal,
  DoubleVal,
  BoolVal,
  ObjectRef,
  NullVal,
  ListVal,
  MapVal,
  ArrayVal,
  CallbackRef,  // Reference to a Python callback function
  CharVal,      // Java char (single UTF-16 code unit)
  TemporalVal,  // Date/time value, Python -> Java only
  BigIntVal,    // java.math.BigInteger <-> a Python int
  DecimalVal    // java.math.BigDecimal <-> decimal.Decimal
}

table StringVal { v:string; }
table IntVal { v:long; }      // Java 'int' or 'long' -> 64-bit int
table DoubleVal { v:double; }
table BoolVal { v:bool; }
table ObjectRef { id:long; }
table NullVal {}
table CharVal { v:ushort; }   // Java char is 16-bit unsigned

// A Python datetime/date/time argument. The server turns it into the matching
// java.sql type, so the client needs no extra round trips to build one.
enum TemporalKind : byte {
  Timestamp = 0,  // v = microseconds since the Unix epoch  -> java.sql.Timestamp
  Date = 1,       // v = days since the Unix epoch          -> java.sql.Date
  Time = 2        // v = seconds since midnight             -> java.sql.Time
}
table TemporalVal { kind:TemporalKind; v:long; }

// Numbers that fit no primitive, in either direction. A Python int travels as a BigIntVal
// only when it does not fit in 64 bits; Java sends every BigInteger as one.
// The integer in two's complement, most significant byte first: BigInteger.toByteArray()
// and int.to_bytes(..., "big", signed=True). Not text: converting an integer of many
// thousand digits to decimal is slow, and Python refuses it past 4300 digits.
table BigIntVal { v:[ubyte]; }
// The decimal as text: BigDecimal.toString() and str(Decimal), each of which the other
// side reads back to the same digits and the same scale.
table DecimalVal { v:string; }

// Reference to a Python callback function
// When Java invokes this, it triggers a callback request to Python
table CallbackRef {
  id: long;              // Callback ID assigned by Python
  interface_name: string; // Java interface to implement (e.g., "java.util.Comparator")
}

// A list, in either direction (Python list <-> java.util.List).
//
// A list whose elements are all integers, all floats, all booleans or all strings travels
// as one vector of them: building a table per element costs the Python client several
// microseconds each. Any other list (mixed, nested, object references, nulls) is one
// Argument per element. At most one of the forms is present; an empty list has none.
table ListVal {
  items: [Argument];
  longs: [long];
  doubles: [double];
  bools: [bool];
  // Strings: the number of UTF-8 bytes of each, and all their bytes end to end
  string_lengths: [int];
  string_bytes: [ubyte];
}

// A map, in either direction (Python dict <-> java.util.Map): its keys and its values in
// the same order, as two lists of one length
table MapVal {
  keys: ListVal;
  values: ListVal;
}

// For Java arrays (int[], String[], Object[], etc.)
// Uses typed vectors for efficiency with primitives
table ArrayVal {
  element_type: ElementType;
  // Primitive arrays - only one is populated based on element_type
  int_values: [int];       // For int[], short[] and char[] (widened)
  long_values: [long];     // For long[]
  double_values: [double]; // For double[] and float[] (widened)
  bool_values: [bool];     // For boolean[]
  byte_values: [byte];     // For byte[]
  // Object arrays (String[], Object[], etc.)
  object_values: [Argument];  // For String[] and Object[]
}

table Argument {
  val: Value;
  // Optional type hint for overload resolution
  // When set, Java uses this type instead of inferring from val_type
  // Examples: "int", "long", "java.lang.Integer", "java.util.List", "scala.collection.Seq"
  type_hint: string;
}

// --- Arrow Zero-Copy Transfer Types ---

// Describes a single buffer in the payload shared memory
// Note: Absent buffers (e.g., no validity bitmap when no nulls) are represented
// as zero-length buffers (offset=0, length=0). This is required because Arrow's
// VectorLoader expects the exact buffer count from TypeLayout, and doesn't handle
// null/absent buffers well. See: https://issues.apache.org/jira/browse/ARROW-8803
table BufferDescriptor {
  offset: uint64;      // Offset from start of payload shm
  length: uint64;      // Buffer size in bytes (0 for absent buffers)
}

// Describes an Arrow field's buffer layout
table FieldNode {
  length: int64;       // Number of values in this field/array
  null_count: int64;   // Number of null values
}

// Arrow batch descriptor for zero-copy transfer
// Sent with SendArrowBuffers action (Python -> Java) or in Response (Java -> Python)
//
// PAYLOAD ZONE LAYOUT (with dynamic allocation):
// The payload shared memory is logically divided into two halves:
// - First half (offset 0 to size/2): Default zone for Python -> Java transfers
// - Second half (offset size/2 to size): Default zone for Java -> Python transfers
//
// Dynamic zone allocation allows using the full zone for unidirectional transfers
// when the opposite direction's zone is not in use. The `direction` field indicates
// the transfer direction, enabling the receiver to know which zone to expect data in.
//
// Buffer offsets in this descriptor are absolute offsets from the start of
// the payload zone, so Python/Java can compute the correct address as:
//   buffer_address = payload_base_address + buffer_descriptor.offset
//
// Default allocation (for bidirectional safety):
// When Python sends data: offsets are in [0, size/2)
// When Java sends data: offsets are in [size/2, size)
//
// Full zone allocation (when opposite zone is free):
// Either side may use offsets in [0, size) for the full capacity
table ArrowBatchDescriptor {
  // Schema: serialized Arrow IPC schema bytes (cached by hash)
  schema_hash: uint64;        // Hash of schema for caching
  schema_bytes: [byte];       // Serialized schema (omit if Java has cached this hash)

  // Layout metadata
  num_rows: int64;            // Total number of rows
  nodes: [FieldNode];         // Field nodes describing array structure

  // Buffer locations in payload shm (absolute offsets from payload zone start)
  buffers: [BufferDescriptor];

  // Arena epoch for lifetime safety
  // Incremented on each reset_payload_arena() call
  // Tables with stale epoch are invalid after arena reset
  arena_epoch: uint64;

  // Transfer direction for dynamic zone allocation
  // 0 = Python -> Java (default, uses first half of zone)
  // 1 = Java -> Python (uses second half of zone)
  // When opposite direction's zone is free, the full zone may be used
  direction: ubyte = 0;
}

// --- Vectorized Command Support ---
// For executing multiple similar operations in a single round-trip

// For GetFields: get multiple field values from one object
table GetFieldsRequest {
  field_names: [string];    // List of field names to read
}

// For InvokeMethods: invoke multiple methods on same target
table MethodCall {
  method_name: string;      // Method name
  args: [Argument];         // Arguments for this method call
  return_object_ref: bool;  // If true, return as ObjectRef instead of auto-converting
}

table InvokeMethodsRequest {
  method_calls: [MethodCall];  // List of method invocations
}

// For CreateObjects: create multiple objects in one round-trip
table ObjectSpec {
  class_name: string;       // Fully qualified class name
  args: [Argument];         // Constructor arguments
}

table CreateObjectsRequest {
  objects: [ObjectSpec];    // List of objects to create
}

// --- Batch Command Support ---
// For executing multiple commands in a single round-trip

// Forward declaration needed for BatchCommand
// Note: FlatBuffers allows forward references within the same file

// --- Callback connection ---
// A callback made by the thread that is running the session's request travels in band: Java
// writes a Response with is_callback set into the response zone and reads a CallbackResponse
// command from the command zone. Every other thread uses the session's callback connection, a
// second socket that carries no shared memory:
//
//   frame = [4 bytes: length, little endian][that many bytes: a FlatBuffer]
//
//   Java -> Python: a Response with is_callback set and a call_id of Java's choosing
//   Python -> Java: a Command with action = CallbackResponse and the same call_id
//
// Until it answers, the callback can call Java on the same connection, and the Java thread
// that is waiting for the answer runs the call:
//
//   Python -> Java: a Command with action = NestedCommand, the call's call_id, and the
//                   command to run, serialized, in nested_command
//   Java -> Python: a Response (is_callback not set) with the same call_id
//
// One at a time per call. If Java is no longer waiting for the call (its thread was
// interrupted), the command is not run and the Response is an error of type
// "org.gatun.server.CallbackCallEnded"; the client then uses its own channel.
// A frame with no call_id belongs to no call: Python releasing
// objects (FreeObject), or Java reporting a callback whose proxy is gone
// (Response.callback_released).
//
// Arrow tables do not travel in frames. A callback that moves one (ArrowToObject,
// ArrowFromObject) first sends OpenCallMemory: Java creates a shared memory file for that
// call, as large as the session's, and returns its path. The file is all payload: a stream's
// offset counts from its start. It belongs to the call and is removed when the call ends.
//
// The server reads this connection in order and decodes each answer before it reads on, so
// a release that follows an answer on it never overtakes the answer. See also
// Command.answers_sent.
//
// Calls from several threads are in flight at once and are answered in any order; call_id is
// what pairs an answer with its call. A frame is at most 64KB, the size of the zones the
// in-band path uses.

// Request from Python -> Java
table Command {
  action: Action;
  target_name: string;
  target_id: long;
  args: [Argument];
  request_id: long;  // Optional: ID for this request, shown in the server's request log
  arrow_batch: ArrowBatchDescriptor;  // For SendArrowBuffers action
  return_object_ref: bool;  // If true, return result as ObjectRef instead of auto-converting
  batch: BatchCommand;  // For Action.Batch: contains sub-commands to execute
  // Vectorized operation requests (for Action.GetFields, InvokeMethods, CreateObjects)
  get_fields: GetFieldsRequest;
  invoke_methods: InvokeMethodsRequest;
  create_objects: CreateObjectsRequest;
  // For Action.ArrowToObject: where in the payload zone the Arrow IPC stream is
  arrow_stream: BufferDescriptor;
  // On the callback connection: which call this frame belongs to
  call_id: long;
  // For Action.NestedCommand: a serialized Command
  nested_command: [ubyte];
  // For Action.FreeObject on the session's own channel: how many callback answers the client
  // had sent on its callback connection when it built this command. One of them may name an
  // object that is released here, and the server has to have read it first.
  answers_sent: long;
  // For Action.RegisterCallback with a handler that is an object, not a function: the names
  // of its methods. A default method of the interface with one of these names is the
  // handler's to answer; the others run in Java.
  callback_methods: [string];
  // For Action.ArrowToObject
  arrow_form: ArrowForm;
  // On any command: objects to release before it runs. A handle the client dropped is
  // released with its next command, not with a round trip of its own. answers_sent goes
  // with these as it does with FreeObject.
  free_ids: [long];
}

// Batch of commands to execute sequentially
table BatchCommand {
  commands: [Command];      // Commands to execute in order
  stop_on_error: bool;      // If true, stop on first error; if false, continue all
}

// Response from Java -> Python
table Response {
  // If true, Python should raise an exception
  is_error: bool;

  // If is_error is true, this holds the stack trace
  error_msg: string;

  // If is_error is true, this holds the exception class name
  // e.g., "java.lang.NumberFormatException", "java.lang.SecurityException"
  error_type: string;

  // If is_error is false and not a callback, this holds the return data
  return_val: Value;

  // If true, this is a callback invocation request (Java calling Python)
  is_callback: bool;

  // For callback invocations:
  callback_id: long;       // Which Python callback to invoke
  callback_method: string; // Method name being called (e.g., "compare", "apply")
  callback_args: [Argument]; // Arguments to pass to the callback

  // For Arrow data responses (Java -> Python zero-copy transfer)
  arrow_batch: ArrowBatchDescriptor;

  // For batch responses (Action.Batch)
  batch: BatchResponse;  // Contains results for each sub-command

  // For vectorized responses (GetFields, InvokeMethods, CreateObjects)
  // Returns ListVal containing results in same order as requests
  // For GetFields: list of field values
  // For InvokeMethods: list of method return values
  // For CreateObjects: list of ObjectRef for created objects

  // For Action.ArrowFromObject: where in the payload zone the Arrow IPC stream was written
  arrow_stream: BufferDescriptor;

  // On the callback connection: which call this frame belongs to
  call_id: long;

  // On the callback connection, with callback_id and nothing else: the callback's proxy was
  // garbage collected, so Java will not call it again and the client may drop its function
  callback_released: bool;

  // If is_error is true: the ID of the exception that was thrown, registered for the session like
  // a returned object. 0 when there is none (an error the server made up without an exception, or
  // a session at its object limit).
  error_object: long;
}

// Batch of responses (one per command in BatchCommand)
table BatchResponse {
  responses: [Response];    // Results in same order as commands
  error_index: int = -1;    // Index of first error (-1 if no errors)
}

// Callback result from Python -> Java (sent as a follow-up Command)
// Uses Action.Ping with callback_result populated
table CallbackResult {
  callback_id: long;    // Which callback this is a response for
  return_val: Value;    // Return value from Python callback
  is_error: bool;       // True if callback raised an exception
  error_msg: string;    // Error message if is_error
}

root_type Command;
